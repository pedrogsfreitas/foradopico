# Copie para .env e preencha. O .env nunca vai para o repositório.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha

# Chaves do MVP. Gere cada valor com:  python -c "import secrets; print(secrets.token_hex(24))"
# Em branco, o grupo de endpoints correspondente fica fechado (responde 503).
# Robô RPA (header X-Api-Key):
ROBOT_API_KEY=
# Visão computacional e ESP32 (header X-Api-Key):
SENSOR_API_KEY=
# Área do RH no app:
HR_ACCESS_CODE=
# Endereço da API do assistente (repositório de Generative AI), sem /perguntar no final.
# Com o assistente rodando na sua máquina na porta 8010:  LLM_API_URL=http://host.docker.internal:8010
# Em branco, a tela "Pergunte" avisa que o assistente não está conectado.
LLM_API_URL=
